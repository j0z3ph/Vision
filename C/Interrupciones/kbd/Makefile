MAKE=make CC=gcc

src/Kbuild:
	echo "# autogenerated, do not edit " > $@
	echo "ccflags-y += -Wno-unused-function -Wno-unused-label -Wno-unused-variable " >> $@
	for i in $(shell cd src && find -mindepth 1 -name Kbuild | xargs --no-run-if-empty dirname); do echo "obj-m += $$i/" >> $@; done

build: src/Kbuild
	$(MAKE) -C /lib/modules/$(shell uname -r)/build M=$(PWD)/src modules
	for i in $(shell find src -name Makefile | xargs --no-run-if-empty dirname); do $(MAKE) -C $$i; done

clean:
	$(MAKE) -C /lib/modules/$(shell uname -r)/build M=$(PWD)/src clean
	for i in $(shell find src -name Makefile | xargs --no-run-if-empty dirname); do $(MAKE) -C $$i clean; done

.PHONY: build clean 